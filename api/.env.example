# ZIMBA RENT backend — environment values live ONLY on the API server.
# Public front end is hosted by GitHub Pages. Never place credentials in assets/.
PORT=3000
CORS_ORIGINS=https://mdanson27.github.io

# Public read-only marketplace routes (optional; use a restricted Neon role)
# DATABASE_URL=postgresql://restricted_readonly_role@.../neondb?sslmode=require

# Verified Neon Auth JWT for existing admin routes and new Phase 5B AI routes
NEON_AUTH_BASE_URL=https://YOUR-NEON-AUTH-HOST.example/your-auth-path
NEON_AUTH_JWKS_URL=https://YOUR-NEON-AUTH-HOST.example/your-auth-path/.well-known/jwks.json

# Public Neon Data API service URL. Server forwards the verified user's JWT:
# Neon will check organisation-scoped RPC permissions itself.
ZIMBA_NEON_DATA_API_URL=https://YOUR-NEON-DATA-API/rest/v1

# Phase 5B AI — configure privately in host environment, never commit a value
# OPENAI_API_KEY=server-secret
ZIMBA_AI_MODEL=gpt-4.1-mini

# Existing platform-admin routes only (optional; do not reuse for AI document extraction)
# ADMIN_DATABASE_URL=postgresql://privileged_server_only@.../neondb?sslmode=require
